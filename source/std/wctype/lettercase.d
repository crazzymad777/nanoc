module nanoc.std.wctype.lettercase;

import nanoc.meta: Omit;

unittest
{
    // import nanoc.std.stdio;
    // import nanoc.std.ctype;
    // printf("%d\n", cast(int) 'S');
    // printf("%d\n", towupper('s'));
    // printf("%d\n", toupper('s'));
    assert(towupper('s') == 'S');
    assert(towupper('я') == 'Я');
    assert(towlower('S') == 's');
    assert(towlower('Я') == 'я');
}

@Omit int getValue(dchar x) pure
{
    //
    int low = 0;
    int high = cast(int)range.length - 1 - 1;
    int mid = 0;

    if (x >= 0x10D86)
    {
        return values[range.length - 1];
    }

    while (low <= high)
    {
        mid = (low + high) / 2; // 2
        if (x >= range[mid] && x < range[mid+1])
        {
            break;
        }

        if (range[mid] < x)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }

    int v = values[mid];
    int sign = 0;
    if (v > 0)
    {
        sign = 1;
    }
    else
    {
        sign = -1;
        v = -v;
    }

    return sign*(x-range[mid]+v);
}

extern (C) int towupper(dchar x) pure
{
    if (x == 0x1c5 || x == 0x1c8 || x == 0x1cb || x == 0x1f2) return x - 1;
    int value = getValue(x);
    if (value > 0)
    {
        return value;
    }
    return x;
}

extern (C) int towlower(dchar x) pure
{
    if (x == 0x1c5 || x == 0x1c8 || x == 0x1cb || x == 0x1f2) return x + 1;
    int value = getValue(x);
    if (value < 0)
    {
        return -value;
    }
    return x;
}

