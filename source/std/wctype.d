module nanoc.std.wctype;

import nanoc.meta: SetKey, Nake, Typedef;

import std.meta: Alias;

@Typedef @SetKey("wchar_t") @Nake enum _dchar = "dchar";
@Typedef @SetKey("wint_t") @Nake enum _int = "wchar_t";
@Typedef @SetKey("wctype_t") @Nake enum _wctype = "int";
alias WEOF = Alias!(-1);

extern (C) int wctype(const char* str)
{
    import nanoc.std.string;
    if (strcmp("alnum", str) == 0) return WideCharBitmask.ALPHA | WideCharBitmask.DIGIT;
    if (strcmp("alpha", str) == 0) return WideCharBitmask.ALPHA;
    if (strcmp("lower", str) == 0) return WideCharBitmask.LOWER;
    if (strcmp("upper", str) == 0) return WideCharBitmask.UPPER;
    if (strcmp("digit", str) == 0) return WideCharBitmask.DIGIT;
    if (strcmp("xdigit", str) == 0) return WideCharBitmask.XDIGIT;
    if (strcmp("cntrl", str) == 0) return WideCharBitmask.CNTRL;
    if (strcmp("graph", str) == 0) return WideCharBitmask.GRAPH;
    if (strcmp("space", str) == 0) return WideCharBitmask.SPACE;
    if (strcmp("blank", str) == 0) return WideCharBitmask.BLANK;
    if (strcmp("print", str) == 0) return WideCharBitmask.PRINT;
    if (strcmp("punct", str) == 0) return WideCharBitmask.PUNCT;
    return 0;
}

extern (C) int iswctype(dchar wc, int desc)
{
    return checkWcByBitmask(wc, cast(WideCharBitmask) desc);
}

unittest
{
    // Test binary search
    assert(Sequential_getBitset(34814) == getBitset(34814));
    assert(Sequential_getBitset(69629) == getBitset(69629));
    assert(Sequential_getBitset(1000) == getBitset(1000));
    assert(Sequential_getBitset(0) == getBitset(0));

    // for (int i = 0; i < 69640; i++)
    // {
    //     // printf("%d\n", i);
    //     assert(Sequential_getBitset(i) == getBitset(i));
    // }

    assert(iswalpha('Б') == 1);
    assert(iswlower('т') == 1);
    assert(iswlower('И') == 0);
    assert(iswupper('т') == 0);
    assert(iswupper('И') == 1);
    assert(iswdigit('f') == 0);
    assert(iswxdigit('f') == 1);
    assert(iswblank(' ') == 1);
    assert(iswprint('Й') == 1);
    assert(iswpunct(',') == 1);
    assert(iswspace('\n') == 1);
    assert(iswcntrl('\b') == 1);
}

@Omit enum WideCharBitmask
{
    // ALNUM = 0b1,
    ALPHA = 0b10,
    LOWER = 0b100,
    UPPER = 0b1000,
    DIGIT = 0b10000,
    XDIGIT = 0b100000,
    CNTRL = 0b1000000,
    GRAPH = 0b10000000,
    SPACE = 0b100000000,
    BLANK = 0b1000000000,
    PRINT = 0b10000000000,
    PUNCT = 0b100000000000
};

@Omit int getBitset(dchar x) pure
{
    //
    int low = 0;
    int high = cast(int)range.length - 1 - 1;
    int mid = 0;

    if (x >= 69630)
    {
        return bitsets[range.length - 1];
    }

    while (low <= high)
    {
        mid = (low + high) / 2; // 2
        if (x >= range[mid] && x < range[mid+1])
        {
            break;
        }

        if (range[mid] < x)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }
    return bitsets[mid];
}

@Omit bool checkWcByBitmask(dchar x, WideCharBitmask bitmask) pure
{
    return cast(bool) (getBitset(x) & bitmask);
}

@Omit int Sequential_getBitset(dchar x) pure
{
    int i = 0;
    for (; i < range.length - 1; i++)
    {
        if (x >= range[i] && x < range[i+1])
        {
            break;
        }
    }
    return bitsets[i];
}

extern (C) int iswcntrl(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.CNTRL);
}

extern (C) int iswblank(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.BLANK);
}

extern (C) int iswspace(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.SPACE);
}

extern (C) int iswupper(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.UPPER);
}

extern (C) int iswlower(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.LOWER);
}

extern (C) int iswalpha(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.ALPHA);
}

extern (C) int iswdigit(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.DIGIT);
}

extern (C) int iswalnum(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.ALPHA | WideCharBitmask.DIGIT);
}

extern (C) int iswxdigit(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.XDIGIT);
}

extern (C) int iswprint(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.PRINT);
}

extern (C) int iswgraph(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.GRAPH);
}

extern (C) int iswpunct(dchar x) pure
{
    return checkWcByBitmask(x, WideCharBitmask.PUNCT);
}

